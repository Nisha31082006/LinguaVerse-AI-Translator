# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/linguaverse"

# ── Redis ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=any_long_random_string_12345
JWT_REFRESH_SECRET=a_different_long_random_string_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Providers ──────────────────────────────────────
# Gemini is the primary/default provider for translation, OCR
# translation, document translation, the AI tutor, and live conversation.
# It has a genuinely free tier — no credit card required. Get a key at:
# https://aistudio.google.com/app/apikey
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the Gemini model. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# OPTIONAL / not required to run the app. OpenAI is kept only as a second
# provider for the /translate "compare providers" feature — nothing else
# uses it, and the app never silently falls back to it if Gemini fails.
# Leave this blank if you don't have OpenAI credits; everything else works
# fine without it.
OPENAI_API_KEY=

# Local speech-to-text (no API key, runs on-device via ONNX Runtime).
# Downloads model weights from Hugging Face on first use only.
# "Xenova/whisper-tiny" (multilingual) is the default; "Xenova/whisper-tiny.en"
# is smaller/faster if you only transcribe English audio.
WHISPER_MODEL=Xenova/whisper-tiny
# Note: text-to-speech has no backend config — the frontend uses the
# browser's built-in Web Speech API instead.

# ── Billing (Stripe) ──────────────────────────────────
# Leave blank to disable billing — /billing will show plans but
# checkout will return a clear "not configured" error instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used only by the seed script to attach real Stripe Prices to the
# PRO / ENTERPRISE plans. Create these in the Stripe dashboard first.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# ── Email (for verification / OTP / password reset) ──
EMAIL_USER=
EMAIL_PASSWORD=

# ── File Storage ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
